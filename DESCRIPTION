Package: thermal
Title: Correct Thermal Infrared Images Acquired by Drones
Version: 0.0.0.9000
Authors@R: c(
    person("Marc-André", "Lemay", , "marc-andre.lemay@uqat.ca", role = c("cre", "aut"),
           comment = c(ORCID = "0000-0003-2484-8447")),
    person("Gideon", "Olugbadieye", role = "aut"),
    person("Brahim", "Maylal", role = "aut"),
